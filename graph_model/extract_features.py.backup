
import json
from pathlib import Path

import networkx as nx

from graph_model.dynamic_graph import build_dynamic_graph


BASE_DIR = Path(__file__).resolve().parent.parent

SNAPSHOT_FILE = (
    BASE_DIR / "feature_store" / "snapshots" / "latest.json"
)

OUTPUT_FILE = (
    BASE_DIR / "graph_model" / "graph_features.json"
)


def extract_features_from_snapshot(snapshot):
    """
    Calculate graph features from the dynamic graph
    represented by the current snapshot.
    """

    G = build_dynamic_graph(snapshot)

    print(
        f"Graph used for feature extraction: "
        f"{G.number_of_nodes()} nodes, "
        f"{G.number_of_edges()} edges"
    )

    # Weighted graph metrics.
    pagerank = nx.pagerank(
        G,
        weight="weight"
    )

    betweenness = nx.betweenness_centrality(
        G,
        weight="weight"
    )

    degree_cent = nx.degree_centrality(G)

    features = {}

    for node in G.nodes():

        features[node] = {
            "pagerank": round(
                pagerank[node],
                6
            ),

            "betweenness": round(
                betweenness[node],
                6
            ),

            "degree_centrality": round(
                degree_cent[node],
                6
            ),

            "in_degree": G.in_degree(node),

            "out_degree": G.out_degree(node),
        }

    return features


def extract_features():

    with open(
        SNAPSHOT_FILE,
        "r"
    ) as file:

        snapshot = json.load(file)

    features = extract_features_from_snapshot(
        snapshot
    )

    with open(
        OUTPUT_FILE,
        "w"
    ) as file:

        json.dump(
            features,
            file,
            indent=2
        )

    print(
        f"Saved dynamic graph features to "
        f"{OUTPUT_FILE}"
    )

    return features


if __name__ == "__main__":

    features = extract_features()

    print(
        "\nDynamic graph features:"
    )

    for node, values in features.items():

        print(
            f"{node:30s} "
            f"PR={values['pagerank']:.4f} "
            f"BC={values['betweenness']:.4f} "
            f"in={values['in_degree']} "
            f"out={values['out_degree']}"
        )
